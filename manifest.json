{
    "manifest_version": 3,
    "name": "AI Writing Assistant",
    "version": "1.0.0",
    "description": "AI writing assistant for any web page. Supports Gemini, OpenAI, Anthropic, OpenRouter, and Ollama. Select text or images for instant AI-powered writing help.",
    "permissions": [
        "activeTab",
        "storage",
        "contextMenus",
        "identity"
    ],
    "oauth2": {
        "client_id": "YOUR_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com",
        "scopes": ["openid", "email", "profile"]
    },
    "host_permissions": [
        "https://generativelanguage.googleapis.com/*",
        "https://api.openai.com/*",
        "https://api.anthropic.com/*",
        "https://openrouter.ai/*",
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://www.googleapis.com/*",
        "https://oauth2.googleapis.com/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "selection-utils.js",
                "content.js"
            ],
            "run_at": "document_idle"
        }
    ],
    "options_ui": {
        "page": "options.html",
        "open_in_tab": false
    },
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    }
}